# InfraShield environment configuration.
# Copy to .env and adjust as needed:  cp .env.example .env

# --- Overpass API -----------------------------------------------------------
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=180
OVERPASS_RETRIES=3
# Byte-cache directory for raw Overpass responses (repeat runs = no re-download)
OVERPASS_CACHE_DIR=data/cache/overpass

# --- PostgreSQL / PostGIS (scripts/init_db.py, scripts/load_to_postgis.py) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=infrashield
PGUSER=postgres
PGPASSWORD=postgres

# --- Docker PostGIS quickstart (see README) ---------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=infrashield
